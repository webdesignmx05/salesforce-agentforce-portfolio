# Railway will inject PORT automatically. Keep 3000 for local dev only.
PORT=3000
NODE_ENV=development

# Keep false until your Salesforce Connected App is ready and tested.
SALESFORCE_ENABLE_LIVE=false

# Your Salesforce login base. For client credentials flow, use your Salesforce My Domain base URL.
SALESFORCE_LOGIN_URL=https://your-domain.my.salesforce.com

# Connected App values. Do not commit real values.
SALESFORCE_CLIENT_ID=REPLACE_WITH_CONSUMER_KEY
SALESFORCE_CLIENT_SECRET=REPLACE_WITH_CONSUMER_SECRET

# Optional if using client credentials flow. Some Salesforce orgs require a run-as user / client-credentials setup in the Connected App.
SALESFORCE_GRANT_TYPE=client_credentials

# Used only if you expand the project to authorization code flow.
SALESFORCE_REDIRECT_URI=http://localhost:3000/oauth/callback

# Optional instance override if you already know your My Domain / instance URL.
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com

# Public raw GraphQL is disabled by default. Keep false for this portfolio demo.
# The Analytics app now calls the safer /api/salesforce/graphql/account-query endpoint.
SALESFORCE_ALLOW_RAW_GRAPHQL=false

# CORS: comma-separated list of Vercel app URLs allowed to call this proxy.
# Example: https://unified-profile.vercel.app,https://agentforce-chat.vercel.app,https://commerce-analytics.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
